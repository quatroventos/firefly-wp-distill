{
  "name": "firefly/distill",
  "description": "Plugin interno firefly-distill: mapeamento multi-host, fila e receive-build.",
  "type": "wordpress-plugin",
  "license": "proprietary",
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "FireflyDistill\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "FireflyDistill\\Tests\\": "tests/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  }
}
