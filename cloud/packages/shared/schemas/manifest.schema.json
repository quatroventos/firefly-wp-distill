{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://firefly.internal/schemas/manifest.json",
  "title": "firefly-distill build manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["host", "build_id", "created_at", "pages", "hostmeta"],
  "properties": {
    "host": {
      "type": "string",
      "pattern": "^[a-z0-9.-]+$"
    },
    "build_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 64
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "pages": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "post_id",
          "source_url",
          "output_relpath",
          "origin_hash",
          "output_hash",
          "post_modified_gmt"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^/"
          },
          "post_id": {
            "type": "integer",
            "minimum": 0
          },
          "source_url": {
            "type": "string",
            "minLength": 1
          },
          "output_relpath": {
            "type": "string",
            "minLength": 1
          },
          "origin_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "output_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "post_modified_gmt": {
            "type": ["string", "null"]
          }
        }
      }
    },
    "hostmeta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["robots", "sitemap", "llm_txt"],
      "properties": {
        "robots": { "type": "boolean" },
        "sitemap": { "type": "boolean" },
        "llm_txt": { "type": "boolean" }
      }
    }
  }
}
