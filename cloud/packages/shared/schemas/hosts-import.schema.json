{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://firefly.internal/schemas/hosts-import.json",
  "title": "firefly-distill hosts CSV row",
  "type": "object",
  "additionalProperties": false,
  "required": ["host", "post_id"],
  "properties": {
    "host": { "type": "string", "pattern": "^[a-z0-9.-]+$" },
    "post_id": { "type": "integer", "minimum": 1 },
    "path": { "type": "string", "pattern": "^/" },
    "https": { "type": "boolean" },
    "robots": { "type": "boolean" },
    "sitemap": { "type": "boolean" },
    "llm": { "type": "boolean" },
    "static": { "type": "boolean" }
  }
}
